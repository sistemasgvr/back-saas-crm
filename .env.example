# Neon PostgreSQL — copiar a .env y rellenar el password
PGHOST=ep-delicate-darkness-axsciins-pooler.c-4.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-delicate-darkness-axsciins-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

PORT=4000

# Seed admin plataforma — Fase 1
SEED_ADMIN_EMAIL=sistemas@proyectosgvr.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Sistemas
SEED_ADMIN_APELLIDO=GVR

# Auth (JWT) — Fase 2
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Meta (OAuth + webhook) — Fase 7-9
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WEBHOOK_URL_TOKEN=
META_OAUTH_REDIRECT_URI=https://{dominio}/api/meta/oauth/callback
META_TOKEN_ENCRYPTION_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
