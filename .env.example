# Plantilla de variables — el backend carga el archivo real según NODE_ENV:
#   NODE_ENV=development → .env.development (usado por npm run start:dev)
#   NODE_ENV=production  → .env.production  (usado por npm run start:prod / start:hostinger)
#   Fallback si falta una variable en el archivo específico: .env
# Ninguno de esos 3 se sube a git. En Hostinger, las variables se configuran en
# hPanel → Environment variables (esas siempre ganan sobre cualquier archivo).
#
# Para arrancar local: copia este archivo a .env.development y rellena los valores.

# Postgres (EasyPanel u otro). Prisma solo usa DATABASE_URL (no hace falta PGHOST/PGUSER/…).
# Si SSL no está habilitado en el servidor: ?sslmode=disable
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/crm-gvr?sslmode=disable"

# Local dev — NO definir PORT en Hostinger (Passenger lo inyecta; fijarlo manualmente → 503).
PORT=4000

# Seed admin plataforma — Fase 1
SEED_ADMIN_EMAIL=sistemas@proyectosgvr.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Sistemas
SEED_ADMIN_APELLIDO=GVR

# Auth (JWT) — Fase 2
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=24h

# Meta (OAuth + webhook) — Fase 7-9
# META_APP_ID / META_APP_SECRET NO van aquí: cada organización registra su
# propia Meta App desde /settings (guardadas cifradas en meta_conexiones).
# El webhook verifica HMAC con app_secret_cifrado de la org (lookup por page_id).
# META_VERIFY_TOKEN es fallback legacy; cada org tiene webhook_verify_token en DB.
META_VERIFY_TOKEN=
META_WEBHOOK_URL_TOKEN=
# META_APP_SECRET=  # opcional: fallback legacy si aún usas una sola Meta App global
META_OAUTH_REDIRECT_URI=https://back-saas-crm.vercel.app/api/meta/oauth/callback
META_TOKEN_ENCRYPTION_KEY=
# Versión única de Graph API — OAuth dialog + AxiosMetaGraphClient (Fase 14.0)
META_GRAPH_VERSION=v26.0

# Meta App Review — URLs a configurar en Meta Developer Console (por cada Meta App):
#   Privacy Policy URL:     https://crm.proyectosgvr.com/privacidad
#   Terms of Service URL:   https://crm.proyectosgvr.com/terminos
#   Data Deletion Callback: https://<TU_API>/api/meta/data-deletion
#   Deauthorize Callback:   https://<TU_API>/api/meta/deauthorize
# (Frontend status page: /eliminacion-datos/<confirmation_code>)

# Frontend — localhost en development; producción: https://crm.proyectosgvr.com
FRONTEND_URL=http://localhost:3000

# Web Push (avisos en móvil / CRM cerrado). Generar con:
#   npx web-push generate-vapid-keys
# Mismo par público/privado en todos los entornos que compartan suscripciones_push.
# La pública del front (NEXT_PUBLIC_VAPID_PUBLIC_KEY) debe ser idéntica a VAPID_PUBLIC_KEY.
# Sin estas variables el push queda deshabilitado; socket + toast siguen funcionando.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sistemas@proyectosgvr.com

# Cron de agenda en Vercel — Vercel envía Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Recordatorios de agenda por WhatsApp al lead (fuera de ventana 24h).
# Nombre de plantilla APPROVED en Meta; idioma BCP-47 (ej. es, es_PE).
# Si falta la plantilla, el cron solo registra un warning y no falla.
WHATSAPP_AGENDA_REMINDER_TEMPLATE=
WHATSAPP_AGENDA_REMINDER_TEMPLATE_LANG=es

# Vercel: copia todas las variables de arriba en Project → Settings → Environment Variables.
# Ver también .env.vercel.example
