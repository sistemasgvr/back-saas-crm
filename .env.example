# Neon PostgreSQL — copiar a .env y rellenar el password
PGHOST=ep-delicate-darkness-axsciins-pooler.c-4.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
# channel_binding=require puede fallar en algunos hosts compartidos — usar solo sslmode=require.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-delicate-darkness-axsciins-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Local dev — NO definir PORT en Hostinger (Passenger lo inyecta; fijarlo manualmente → 503).
PORT=4000

# Seed admin plataforma — Fase 1
SEED_ADMIN_EMAIL=sistemas@proyectosgvr.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Sistemas
SEED_ADMIN_APELLIDO=GVR

# Auth (JWT) — Fase 2
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Meta (OAuth + webhook) — Fase 7-9
# META_APP_ID / META_APP_SECRET NO van aquí: cada organización registra su
# propia Meta App desde /settings (guardadas cifradas en meta_conexiones).
# El webhook verifica HMAC con app_secret_cifrado de la org (lookup por page_id).
# META_VERIFY_TOKEN es fallback legacy; cada org tiene webhook_verify_token en DB.
META_VERIFY_TOKEN=
META_WEBHOOK_URL_TOKEN=
# META_APP_SECRET=  # opcional: fallback legacy si aún usas una sola Meta App global
META_OAUTH_REDIRECT_URI=https://{dominio}/api/meta/oauth/callback
META_TOKEN_ENCRYPTION_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
