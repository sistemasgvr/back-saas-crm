model WhatsappMensaje {
  id                     String @id @default(uuid()) @db.Uuid
  organizacionId         String @map("organizacion_id") @db.Uuid
  whatsappConversacionId String @map("whatsapp_conversacion_id") @db.Uuid

  /**
   * id de Meta (wamid) — idempotencia ante reintentos de webhook.
   */
  wamid           String   @db.VarChar(128)
  /**
   * entrante | saliente
   */
  direccion       String   @db.VarChar(10)
  /**
   * text | template | image | document | audio | video | sticker | location |
   * contacts | interactive (saliente: botones/lista/link/pedido de ubicación
   * que MANDAMOS) | button_reply | list_reply (entrante: lo que el contacto
   * TOCÓ en respuesta a un interactive nuestro).
   */
  tipo            String   @db.VarChar(20)
  texto           String?
  plantillaNombre String?  @map("plantilla_nombre") @db.VarChar(200)
  /**
   * Id de media en Meta — saliente: el que devuelve nuestro propio upload
   * (válido 30 días, ya no lo necesitamos tras subir el archivo a
   * WhatsappMensajeMedia). Entrante: el que trae el webhook (válido solo
   * 7 días — por eso el archivo se descarga y persiste enseguida, no queda
   * como referencia externa).
   */
  mediaId            String?  @map("media_id") @db.VarChar(128)
  mediaMimeType      String?  @map("media_mime_type") @db.VarChar(100)
  /** Nombre original del archivo — solo aplica a documentos. */
  mediaNombreArchivo String?  @map("media_nombre_archivo")
  /** Texto que Meta manda junto al media (no es el `texto` del mensaje). */
  mediaCaption       String?  @map("media_caption")
  /** true si es una nota de voz (audio.voice de Meta) vs. un archivo de audio normal. */
  mediaEsVoz         Boolean? @map("media_es_voz")
  mediaTamanoBytes   Int?     @map("media_tamano_bytes")
  /**
   * enviado | entregado | leido | fallido — solo aplica a salientes.
   */
  estadoEntrega   String?  @map("estado_entrega") @db.VarChar(20)
  errorMensaje    String?  @map("error_mensaje")
  /**
   * Reacción (emoji) que puso el agente/nuestra org sobre este mensaje —
   * null si ninguna. Vacía-string no se guarda: quitar una reacción deja
   * este campo en null otra vez, igual que "sin reaccionar".
   */
  reaccionAgente  String?  @map("reaccion_agente") @db.VarChar(20)
  /** Reacción que puso el contacto sobre este mensaje — mismo criterio. */
  reaccionCliente String?  @map("reaccion_cliente") @db.VarChar(20)
  /**
   * Cuándo el CONTACTO editó este mensaje por última vez — null si nunca lo
   * editó. WhatsApp no expone historial de ediciones (ni a los usuarios ni
   * por la API), así que `texto`/`mediaCaption` ya quedan pisados con el
   * contenido nuevo — este campo solo sirve para pintar la etiqueta
   * "editado" junto a la hora, igual que hace WhatsApp real. Nosotros (el
   * negocio) no podemos editar mensajes ya enviados — la Cloud API no
   * expone esa acción, solo notifica ediciones que hace el contacto.
   */
  fechaEdicion DateTime? @map("fecha_edicion") @db.Timestamptz
  /**
   * Respuesta contextual (citar un mensaje anterior) — PLAN Fase reacciones/
   * respuestas. Null si el mensaje no responde a nada. Se resuelve al id
   * PROPIO del mensaje citado (no al wamid) para poder traer su contenido
   * con un include, sin una segunda consulta. Si el mensaje citado no está
   * en nuestra base (muy viejo, o Meta no mandó el wamid), queda null — el
   * mensaje igual se guarda, solo sin la cita visual.
   */
  respondeAMensajeId String?           @map("responde_a_mensaje_id") @db.Uuid
  respondeA          WhatsappMensaje?  @relation("RespuestaAMensaje", fields: [respondeAMensajeId], references: [id])
  respuestas         WhatsappMensaje[] @relation("RespuestaAMensaje")
  /**
   * Solo aplica a tipo === 'location'. Nombre/dirección son opcionales — Meta
   * los manda si el usuario compartió un lugar con nombre (ej. un negocio en
   * el mapa) en vez de solo su posición actual.
   */
  ubicacionLatitud   Float?  @map("ubicacion_latitud")
  ubicacionLongitud  Float?  @map("ubicacion_longitud")
  ubicacionNombre    String? @map("ubicacion_nombre") @db.VarChar(255)
  ubicacionDireccion String? @map("ubicacion_direccion") @db.VarChar(500)
  /**
   * Solo aplica a tipo === 'contacts'. WhatsApp permite mandar varios
   * contactos en un mismo mensaje — se guarda tal cual como JSON (array de
   * {nombre, telefonos: [{numero, tipo}], organizacion?}), no hace falta
   * una tabla aparte para algo que nunca se consulta individualmente.
   */
  contactos Json? @map("contactos")
  /**
   * Solo aplica a tipo === 'interactive' (SIEMPRE saliente — la Cloud API no
   * tiene forma de mandar botones/lista desde el lado del contacto). Guarda
   * la forma ya normalizada que arma EnviarInteractivoWhatsAppUseCase — así
   * el propio chat de la org puede repintar qué botones/lista/link mandó,
   * no solo el texto del cuerpo. La respuesta del contacto (qué botón tocó)
   * NO usa este campo — llega como un mensaje de chat normal, con `texto`
   * = título elegido y `tipo` = 'button_reply' | 'list_reply'.
   */
  interactivo Json? @map("interactivo")
  datosCrudos     Json     @map("datos_crudos")
  /**
   * Timestamp real de Meta (puede diferir de fechaCreacion si el webhook llega tarde).
   */
  fechaMensaje    DateTime @map("fecha_mensaje") @db.Timestamptz

  usuarioCreacion String?  @map("usuario_creacion") @db.Uuid
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  whatsappConversacion WhatsappConversacion @relation(fields: [whatsappConversacionId], references: [id])
  media                WhatsappMensajeMedia?

  @@unique([organizacionId, wamid])
  @@index([whatsappConversacionId, fechaMensaje])
  @@map("whatsapp_mensajes")
}

/**
 * Bytes del archivo, en una tabla aparte — así listar/leer mensajes (lo que
 * pasa todo el tiempo) nunca arrastra binarios, y solo se leen al pedir la
 * descarga puntual de un archivo (WhatsappChatsController GET .../media).
 * v1 guarda en Postgres (Bytes) para no depender de un bucket externo que
 * hoy no existe en el proyecto — si el volumen de archivos crece mucho,
 * el paso natural es migrar a un object storage (S3/R2) manteniendo esta
 * misma tabla como índice.
 */
model WhatsappMensajeMedia {
  whatsappMensajeId String   @id @map("whatsapp_mensaje_id") @db.Uuid
  bytes             Bytes    @map("bytes")
