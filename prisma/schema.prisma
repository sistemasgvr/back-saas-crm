generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fase 1 — núcleo SaaS / multi-tenant (PLAN.md §4.2-4.6).
// Fase 2 — auth (§4.13): tokens_refresco.
// Fase 7 — Meta OAuth (§4.8): meta_conexiones.
// Fase 8 — modelo Meta (§4.9-4.12): campanas, conjuntos_anuncios, anuncios, leads.
// La ingestión real (poblar estas tablas desde el webhook) es Fase 9.
// Fase 12 — Notificaciones in-app por WebSocket (sin push del navegador por ahora): notificaciones, notificaciones_usuario.
// Fase 13 — Meta multi-origen (PLAN-FASE-13-META-MULTI.md): meta_paginas, meta_cuentas_publicitarias (N por org).

model Usuario {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  nombre            String    @db.VarChar(120)
  apellido          String?   @db.VarChar(120)
  telefono          String?   @db.VarChar(40)
  avatarUrl         String?   @map("avatar_url")
  esAdminPlataforma Int       @default(0) @map("es_admin_plataforma") @db.SmallInt
  ultimoLogin       DateTime? @map("ultimo_login") @db.Timestamptz

  estado            Int       @default(1) @db.SmallInt
  usuarioCreacion   String?   @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?   @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime  @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacionUsuarios  OrganizacionUsuario[]
  tokensRefresco        TokenRefresco[]
  notificacionesUsuario NotificacionUsuario[]

  @@index([esAdminPlataforma])
  @@index([estado])
  @@map("usuarios")
}

model TokenRefresco {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tokenHash])
  @@index([expiraEn])
  @@index([estado])
  @@map("tokens_refresco")
}

model Organizacion {
  id               String  @id @default(uuid()) @db.Uuid
  nombre           String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(120)
  razonSocial      String? @map("razon_social") @db.VarChar(255)
  documentoFiscal  String? @map("documento_fiscal") @db.VarChar(50)
  emailContacto    String? @map("email_contacto") @db.VarChar(255)
  telefonoContacto String? @map("telefono_contacto") @db.VarChar(40)
  logoUrl          String? @map("logo_url")
  pais             String? @db.VarChar(2)
  zonaHoraria      String  @default("America/Lima") @map("zona_horaria") @db.VarChar(64)
  notas            String?

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacionUsuarios     OrganizacionUsuario[]
  organizacionModulos      OrganizacionModulo[]
  metaConexiones           MetaConexion[]
  metaPaginas              MetaPagina[]
  metaCuentasPublicitarias MetaCuentaPublicitaria[]
  metaFormularios          MetaFormulario[]
  metaInsightsDiarios      MetaInsightDiario[]
  campanas                 Campana[]
  leads                    Lead[]
  notificaciones           Notificacion[]
  notificacionesUsuario    NotificacionUsuario[]

  @@index([estado])
  @@map("organizaciones")
}

model Campana {
  id                       String  @id @default(uuid()) @db.Uuid
  organizacionId           String  @map("organizacion_id") @db.Uuid
  metaCuentaPublicitariaId String? @map("meta_cuenta_publicitaria_id") @db.Uuid
  metaCampanaId            String  @map("meta_campana_id") @db.VarChar(64)
  nombre                   String  @db.VarChar(255)
  estadoMeta               String? @map("estado_meta") @db.VarChar(40)
  datosCrudos              Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion           Organizacion            @relation(fields: [organizacionId], references: [id])
  metaCuentaPublicitaria MetaCuentaPublicitaria? @relation(fields: [metaCuentaPublicitariaId], references: [id])
  conjuntosAnuncios      ConjuntoAnuncio[]
  leads                  Lead[]
  insightsDiarios        MetaInsightDiario[]

  @@unique([organizacionId, metaCampanaId])
  @@index([metaCuentaPublicitariaId])
  @@index([estado])
  @@map("campanas")
}

model ConjuntoAnuncio {
  id             String  @id @default(uuid()) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  campanaId      String  @map("campana_id") @db.Uuid
  metaConjuntoId String  @map("meta_conjunto_id") @db.VarChar(64)
  nombre         String  @db.VarChar(255)
  estadoMeta     String? @map("estado_meta") @db.VarChar(40)
  datosCrudos    Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  campana  Campana   @relation(fields: [campanaId], references: [id])
  anuncios Anuncio[]
  leads    Lead[]

  @@unique([organizacionId, metaConjuntoId])
  @@index([campanaId])
  @@index([estado])
  @@map("conjuntos_anuncios")
}

model Anuncio {
  id                String  @id @default(uuid()) @db.Uuid
  organizacionId    String  @map("organizacion_id") @db.Uuid
  conjuntoAnuncioId String  @map("conjunto_anuncio_id") @db.Uuid
  metaAnuncioId     String  @map("meta_anuncio_id") @db.VarChar(64)
  nombre            String  @db.VarChar(255)
  estadoMeta        String? @map("estado_meta") @db.VarChar(40)
  datosCrudos       Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  conjuntoAnuncio ConjuntoAnuncio @relation(fields: [conjuntoAnuncioId], references: [id])
  leads           Lead[]

  @@unique([organizacionId, metaAnuncioId])
  @@index([conjuntoAnuncioId])
  @@index([estado])
  @@map("anuncios")
}

model Lead {
  id                String    @id @default(uuid()) @db.Uuid
  organizacionId    String    @map("organizacion_id") @db.Uuid
  metaPaginaId      String?   @map("meta_pagina_id") @db.Uuid
  campanaId         String?   @map("campana_id") @db.Uuid
  conjuntoAnuncioId String?   @map("conjunto_anuncio_id") @db.Uuid
  anuncioId         String?   @map("anuncio_id") @db.Uuid
  formularioId      String?   @map("formulario_id") @db.VarChar(64)
  idExterno         String    @map("id_externo") @db.VarChar(64)
  nombre            String?   @db.VarChar(200)
  email             String?   @db.VarChar(255)
  telefono          String?   @db.VarChar(40)
  datosCrudos       Json      @map("datos_crudos")
  fechaLead         DateTime? @map("fecha_lead") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion    Organizacion     @relation(fields: [organizacionId], references: [id])
  metaPagina      MetaPagina?      @relation(fields: [metaPaginaId], references: [id])
  campana         Campana?         @relation(fields: [campanaId], references: [id])
  conjuntoAnuncio ConjuntoAnuncio? @relation(fields: [conjuntoAnuncioId], references: [id])
  anuncio         Anuncio?         @relation(fields: [anuncioId], references: [id])

  @@unique([organizacionId, idExterno])
  @@index([email])
  @@index([telefono])
  @@index([metaPaginaId])
  @@index([campanaId])
  @@index([anuncioId])
  @@index([fechaLead])
  @@index([estado])
  @@map("leads")
}

model MetaConexion {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid

  // Meta App propia de la organización (cada cliente registra la suya) — se
  // guarda antes de iniciar el OAuth; sin esto no se puede generar la URL.
  appId            String? @map("app_id") @db.VarChar(64)
  appSecretCifrado String? @map("app_secret_cifrado")

  // Se completan recién cuando el OAuth de esa app termina con éxito.
  metaUserId      String?   @map("meta_user_id") @db.VarChar(64)
  metaUserNombre  String?   @map("meta_user_nombre") @db.VarChar(200)
  adAccountId     String?   @map("ad_account_id") @db.VarChar(64)
  adAccountNombre String?   @map("ad_account_nombre") @db.VarChar(200)
  pageId          String?   @map("page_id") @db.VarChar(64)
  pageNombre      String?   @map("page_nombre") @db.VarChar(200)
  tokenCifrado    String?   @map("token_cifrado")
  tokenExpiraEn   DateTime? @map("token_expira_en") @db.Timestamptz
  scopes          String?
  /** IDs de features de meta-permisos-matriz.ts que la org quiere solicitar en
   * OAuth (además de las núcleo, siempre incluidas) — PLAN.md Fase 16. */
  featuresDeseadas Json?    @map("features_deseadas")

  webhookVerifyToken String @map("webhook_verify_token") @db.VarChar(128)

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion             Organizacion             @relation(fields: [organizacionId], references: [id])
  paginas                  MetaPagina[]
  cuentasPublicitarias     MetaCuentaPublicitaria[]

  // page_id único entre conexiones activas: índice parcial en migración
  // 20260817223000_meta_conexiones_page_id_unique (Prisma DSL no soporta partial unique).
  // pageId/pageNombre/adAccountId/adAccountNombre arriba: deprecados desde Fase 13
  // (PLAN-FASE-13-META-MULTI.md §3.3) — el runtime ya no los escribe, ver meta_paginas
  // y meta_cuentas_publicitarias. Se mantienen por ahora para no perder el historial MVP.
  @@index([organizacionId])
  @@index([pageId])
  @@index([adAccountId])
  @@index([estado])
  @@map("meta_conexiones")
}

model MetaPagina {
  id                 String    @id @default(uuid()) @db.Uuid
  organizacionId     String    @map("organizacion_id") @db.Uuid
  metaConexionId     String    @map("meta_conexion_id") @db.Uuid
  pageId             String    @map("page_id") @db.VarChar(64)
  nombre             String    @db.VarChar(200)
  tokenPaginaCifrado String?   @map("token_pagina_cifrado")
  webhookSuscrito    Int       @default(0) @map("webhook_suscrito") @db.SmallInt
  webhookSuscritoEn  DateTime? @map("webhook_suscrito_en") @db.Timestamptz
  webhookUltimoCheckEn DateTime? @map("webhook_ultimo_check_en") @db.Timestamptz
  webhookUltimoError   String?   @map("webhook_ultimo_error")
  fotoUrl            String?   @map("foto_url")
  categoria          String?   @db.VarChar(120)

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  metaConexion MetaConexion @relation(fields: [metaConexionId], references: [id])
  leads        Lead[]
  formularios  MetaFormulario[]

  // page_id único entre páginas activas de CUALQUIER org (misma regla MVP que
  // meta_conexiones) + único dentro de la propia org: índices parciales en
  // migración fase13_1_meta_multi_origen (Prisma DSL no soporta partial unique).
  @@index([organizacionId])
  @@index([metaConexionId])
  @@index([pageId])
  @@index([estado])
  @@map("meta_paginas")
}

model MetaCuentaPublicitaria {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @map("organizacion_id") @db.Uuid
  metaConexionId String    @map("meta_conexion_id") @db.Uuid
  adAccountId    String    @map("ad_account_id") @db.VarChar(64)
  nombre         String    @db.VarChar(200)
  moneda         String?   @db.VarChar(8)
  estadoCuenta   String?   @map("estado_cuenta") @db.VarChar(40)
  timezone       String?   @db.VarChar(64)
  ultimoSyncEn   DateTime? @map("ultimo_sync_en") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  metaConexion MetaConexion @relation(fields: [metaConexionId], references: [id])
  campanas     Campana[]
  insightsDiarios MetaInsightDiario[]

  // (organizacion_id, ad_account_id) único solo entre cuentas ACTIVAS: índice parcial
  // en la misma migración de meta_paginas_page_id_unique (Prisma DSL no soporta partial
  // unique) — evita bloquear re-vincular una cuenta luego de desvincularla (soft-delete).
  @@index([organizacionId, adAccountId])
  @@index([metaConexionId])
  @@index([estado])
  @@map("meta_cuentas_publicitarias")
}

model MetaFormulario {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @map("organizacion_id") @db.Uuid
  metaPaginaId   String    @map("meta_pagina_id") @db.Uuid
  formId         String    @map("form_id") @db.VarChar(64)
  nombre         String    @db.VarChar(200)
  estadoMeta     String?   @map("estado_meta") @db.VarChar(40)
  locale         String?   @db.VarChar(20)
  ultimoSyncEn   DateTime? @map("ultimo_sync_en") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  metaPagina   MetaPagina   @relation(fields: [metaPaginaId], references: [id])

  // (organizacion_id, form_id) único solo entre forms activos: índice parcial
  // en migración fase14_1_meta_formularios (Prisma DSL no soporta partial unique).
  @@index([organizacionId, formId])
  @@index([metaPaginaId])
  @@index([estado])
  @@map("meta_formularios")
}

model MetaInsightDiario {
  id                       String   @id @default(uuid()) @db.Uuid
  organizacionId           String   @map("organizacion_id") @db.Uuid
  metaCuentaPublicitariaId String   @map("meta_cuenta_publicitaria_id") @db.Uuid
  /** NULL = snapshot a nivel cuenta ese día; no NULL = snapshot a nivel campaña. */
  campanaId                String?  @map("campana_id") @db.Uuid
  fecha                    DateTime @db.Date
  spend                    Decimal  @db.Decimal(14, 4)
  impressions              BigInt
  clicks                   BigInt
  ctr                      Decimal? @db.Decimal(10, 6)
  cpc                      Decimal? @db.Decimal(14, 4)
  reach                    BigInt?
  moneda                   String?  @db.VarChar(8)
  datosCrudos              Json?    @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion           Organizacion           @relation(fields: [organizacionId], references: [id])
  metaCuentaPublicitaria MetaCuentaPublicitaria @relation(fields: [metaCuentaPublicitariaId], references: [id])
  campana                Campana?               @relation(fields: [campanaId], references: [id])

  // Unicidad por (organizacion, cuenta, campana NULL-o-no, fecha): dos índices únicos
  // parciales en migración fase15_1_meta_insights_diarios (Prisma DSL no soporta
  // partial unique, y NULL rompe la semántica de un @@unique normal en campana_id).
  @@index([organizacionId, metaCuentaPublicitariaId, fecha])
  @@index([campanaId])
  @@index([fecha])
  @@index([estado])
  @@map("meta_insights_diarios")
}

model OrganizacionUsuario {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid
  usuarioId      String @map("usuario_id") @db.Uuid
  rol            String @db.VarChar(30) // PROPIETARIO | ADMINISTRADOR | USUARIO

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@unique([organizacionId, usuarioId])
  @@index([usuarioId])
  @@index([rol])
  @@index([estado])
  @@map("organizacion_usuarios")
}

model Modulo {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(50) // ej. META_LEADS
  nombre      String  @db.VarChar(120)
  descripcion String?
  icono       String? @db.VarChar(80) // nombre Iconify, ej. mdi:view-dashboard
  orden       Int     @default(0)

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacionModulos OrganizacionModulo[]

  @@map("modulos")
}

model OrganizacionModulo {
  id              String    @id @default(uuid()) @db.Uuid
  organizacionId  String    @map("organizacion_id") @db.Uuid
  moduloId        String    @map("modulo_id") @db.Uuid
  habilitado      Int       @default(0) @db.SmallInt
  fechaActivacion DateTime? @map("fecha_activacion") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  modulo       Modulo       @relation(fields: [moduloId], references: [id])

  @@unique([organizacionId, moduloId])
  @@index([habilitado])
  @@index([estado])
  @@map("organizacion_modulos")
}

model Notificacion {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid
  tipo           String @db.VarChar(50) // discriminador, ej. "LEAD_NUEVO" — nuevos tipos no requieren migración
  titulo         String @db.VarChar(200)
  mensaje        String @db.VarChar(500)
  payload        Json? // datos específicos del tipo, ej. { leadId }

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion  Organizacion          @relation(fields: [organizacionId], references: [id])
  destinatarios NotificacionUsuario[]

  @@index([organizacionId])
  @@index([tipo])
  @@index([estado])
  @@map("notificaciones")
}

model NotificacionUsuario {
  id             String    @id @default(uuid()) @db.Uuid
  notificacionId String    @map("notificacion_id") @db.Uuid
  organizacionId String    @map("organizacion_id") @db.Uuid // denormalizado (misma convención que Lead/Campana) — evita join en conteo/listado
  usuarioId      String    @map("usuario_id") @db.Uuid
  leida          Int       @default(0) @db.SmallInt
  fechaLectura   DateTime? @map("fecha_lectura") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  notificacion Notificacion @relation(fields: [notificacionId], references: [id])
  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@unique([notificacionId, usuarioId])
  @@index([usuarioId, leida])
  @@index([organizacionId, usuarioId])
  @@index([notificacionId])
  @@index([estado])
  @@map("notificaciones_usuario")
}
