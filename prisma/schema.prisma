   */
  leadId             String? @map("lead_id") @db.Uuid

  /**
   * Teléfono E.164 sin '+' — mismo formato que usa el payload de Meta. Es la
   * clave real de una conversación: uno por (org, wa_id), con o sin lead.
   */
  waId            String    @map("wa_id") @db.VarChar(40)
  nombreContacto  String?   @map("nombre_contacto") @db.VarChar(200)
  ultimoMensajeEn DateTime? @map("ultimo_mensaje_en") @db.Timestamptz
  /**
   * 24h desde el último mensaje ENTRANTE — mientras no expire se puede mandar
   * mensaje de sesión libre; si expiró, solo plantilla aprobada.
   */
  ventanaExpiraEn DateTime? @map("ventana_expira_en") @db.Timestamptz
  noLeidos        Int       @default(0) @map("no_leidos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
