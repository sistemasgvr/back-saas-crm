generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fase 1 — núcleo SaaS / multi-tenant (PLAN.md §4.2-4.6).
// Fase 2 — auth (§4.13): tokens_refresco.
// Fase 7 — Meta OAuth (§4.8): meta_conexiones.
// Fase 8 — modelo Meta (§4.9-4.12): campanas, conjuntos_anuncios, anuncios, leads.
// La ingestión real (poblar estas tablas desde el webhook) es Fase 9.
// Fase 12 — Notificaciones in-app por WebSocket (sin push del navegador por ahora): notificaciones, notificaciones_usuario.
// Fase 13 — Meta multi-origen (PLAN-FASE-13-META-MULTI.md): meta_paginas, meta_cuentas_publicitarias (N por org).

model Usuario {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  nombre            String    @db.VarChar(120)
  apellido          String?   @db.VarChar(120)
  telefono          String?   @db.VarChar(40)
  avatarUrl         String?   @map("avatar_url")
  esAdminPlataforma Int       @default(0) @map("es_admin_plataforma") @db.SmallInt
  ultimoLogin       DateTime? @map("ultimo_login") @db.Timestamptz

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacionUsuarios  OrganizacionUsuario[]
  tokensRefresco        TokenRefresco[]
  notificacionesUsuario NotificacionUsuario[]
  leadsAsignados        Lead[]                @relation("LeadAsignado")
  leadsAsignadosPor     Lead[]                @relation("LeadAsignadoPor")
  leadEstadoHistorial   LeadEstadoHistorial[]
  leadVisitasAsignadas  LeadVisita[]          @relation("LeadVisitaAsignado")
  leadVisitasCreadas    LeadVisita[]          @relation("LeadVisitaCreadoPor")
  leadCalificaciones    LeadCalificacion[]    @relation("LeadCalificacionUsuario")

  leadAutoAsignacionConfigsPrimero LeadAutoAsignacionConfig[] @relation("LeadAutoAsignacionPrimero")
  leadAutoAsignacionConfigsSegundo LeadAutoAsignacionConfig[] @relation("LeadAutoAsignacionSegundo")

  @@index([esAdminPlataforma])
  @@index([estado])
  @@map("usuarios")
}

model TokenRefresco {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tokenHash])
  @@index([expiraEn])
  @@index([estado])
  @@map("tokens_refresco")
}

model Organizacion {
  id               String  @id @default(uuid()) @db.Uuid
  nombre           String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(120)
  razonSocial      String? @map("razon_social") @db.VarChar(255)
  documentoFiscal  String? @map("documento_fiscal") @db.VarChar(50)
  emailContacto    String? @map("email_contacto") @db.VarChar(255)
  telefonoContacto String? @map("telefono_contacto") @db.VarChar(40)
  logoUrl          String? @map("logo_url")
  pais             String? @db.VarChar(2)
  zonaHoraria      String  @default("America/Lima") @map("zona_horaria") @db.VarChar(64)
  /**
   * Único valor operativo hoy: INMOBILIARIA. Otros códigos quedan reservados
   * sin producto — PLAN-GESTION-LEADS-WHATSAPP.md §3/§4.1.
   */
  rubro            String  @default("INMOBILIARIA") @db.VarChar(40)
  notas            String?

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacionUsuarios     OrganizacionUsuario[]
  organizacionModulos      OrganizacionModulo[]
  metaConexiones           MetaConexion[]
  metaPaginas              MetaPagina[]
  metaCuentasPublicitarias MetaCuentaPublicitaria[]
  metaFormularios          MetaFormulario[]
  metaInsightsDiarios      MetaInsightDiario[]
  campanas                 Campana[]
  leads                    Lead[]
  leadAutoAsignacionConfig LeadAutoAsignacionConfig?
  leadAutoAsignacionQueue  LeadAutoAsignacionQueue[]
  notificaciones           Notificacion[]
  notificacionesUsuario    NotificacionUsuario[]
  whatsappConexiones       WhatsappConexion[]
  whatsappConversaciones   WhatsappConversacion[]

  @@index([estado])
  @@index([rubro])
  @@map("organizaciones")
}

model Campana {
  id                       String  @id @default(uuid()) @db.Uuid
  organizacionId           String  @map("organizacion_id") @db.Uuid
  metaCuentaPublicitariaId String? @map("meta_cuenta_publicitaria_id") @db.Uuid
  metaCampanaId            String  @map("meta_campana_id") @db.VarChar(64)
  nombre                   String  @db.VarChar(255)
  estadoMeta               String? @map("estado_meta") @db.VarChar(40)
  datosCrudos              Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion           Organizacion            @relation(fields: [organizacionId], references: [id])
  metaCuentaPublicitaria MetaCuentaPublicitaria? @relation(fields: [metaCuentaPublicitariaId], references: [id])
  conjuntosAnuncios      ConjuntoAnuncio[]
  leads                  Lead[]
  insightsDiarios        MetaInsightDiario[]

  @@unique([organizacionId, metaCampanaId])
  @@index([metaCuentaPublicitariaId])
  @@index([estado])
  @@map("campanas")
}

model ConjuntoAnuncio {
  id             String  @id @default(uuid()) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  campanaId      String  @map("campana_id") @db.Uuid
  metaConjuntoId String  @map("meta_conjunto_id") @db.VarChar(64)
  nombre         String  @db.VarChar(255)
  estadoMeta     String? @map("estado_meta") @db.VarChar(40)
  datosCrudos    Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  campana  Campana   @relation(fields: [campanaId], references: [id])
  anuncios Anuncio[]
  leads    Lead[]

  @@unique([organizacionId, metaConjuntoId])
  @@index([campanaId])
  @@index([estado])
  @@map("conjuntos_anuncios")
}

model Anuncio {
  id                String  @id @default(uuid()) @db.Uuid
  organizacionId    String  @map("organizacion_id") @db.Uuid
  conjuntoAnuncioId String  @map("conjunto_anuncio_id") @db.Uuid
  metaAnuncioId     String  @map("meta_anuncio_id") @db.VarChar(64)
  nombre            String  @db.VarChar(255)
  estadoMeta        String? @map("estado_meta") @db.VarChar(40)
  datosCrudos       Json?   @map("datos_crudos")

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  conjuntoAnuncio ConjuntoAnuncio @relation(fields: [conjuntoAnuncioId], references: [id])
  leads           Lead[]

  @@unique([organizacionId, metaAnuncioId])
  @@index([conjuntoAnuncioId])
  @@index([estado])
  @@map("anuncios")
}

model Lead {
  id                String    @id @default(uuid()) @db.Uuid
  organizacionId    String    @map("organizacion_id") @db.Uuid
  metaPaginaId      String?   @map("meta_pagina_id") @db.Uuid
  campanaId         String?   @map("campana_id") @db.Uuid
  conjuntoAnuncioId String?   @map("conjunto_anuncio_id") @db.Uuid
  anuncioId         String?   @map("anuncio_id") @db.Uuid
  formularioId      String?   @map("formulario_id") @db.VarChar(64)
  idExterno         String    @map("id_externo") @db.VarChar(64)
  nombre            String?   @db.VarChar(200)
  email             String?   @db.VarChar(255)
  telefono          String?   @db.VarChar(40)
  datosCrudos       Json      @map("datos_crudos")
  fechaLead         DateTime? @map("fecha_lead") @db.Timestamptz

  /**
   * Inmobiliaria: COMPRA | VENTA | OTRO — opcional (PLAN-GESTION-LEADS-WHATSAPP.md §4.2).
   */
  tipoLead             String?   @map("tipo_lead") @db.VarChar(40)
  asignadoUsuarioId    String?   @map("asignado_usuario_id") @db.Uuid
  asignadoEn           DateTime? @map("asignado_en") @db.Timestamptz
  /**
   * Null si el usuario se auto-tomó ("tomar") en vez de que un admin lo asignara.
   */
  asignadoPorUsuarioId String?   @map("asignado_por_usuario_id") @db.Uuid

  /**
   * Pipeline de gestión (PLAN-PIPELINE-INMOBILIARIA.md §5.1) — códigos
   * UPPER_SNAKE definidos en shared/domain/pipeline-inmobiliaria.ts, distinto
   * catálogo/transiciones según tipoLead (COMPRA/VENTA/OTRO).
   */
  estadoGestion             String    @default("NUEVO") @map("estado_gestion") @db.VarChar(40)
  estadoGestionEn           DateTime? @map("estado_gestion_en") @db.Timestamptz
  estadoGestionPorUsuarioId String?   @map("estado_gestion_por_usuario_id") @db.Uuid
  /** Catálogo corto en código — ver MOTIVOS_DESCARTE/PERDIDO/GANADO. */
  motivoCierre              String?   @map("motivo_cierre") @db.VarChar(80)
  notaCierre                String?   @map("nota_cierre") @db.VarChar(500)

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion           Organizacion           @relation(fields: [organizacionId], references: [id])
  metaPagina             MetaPagina?            @relation(fields: [metaPaginaId], references: [id])
  campana                Campana?               @relation(fields: [campanaId], references: [id])
  conjuntoAnuncio        ConjuntoAnuncio?       @relation(fields: [conjuntoAnuncioId], references: [id])
  anuncio                Anuncio?               @relation(fields: [anuncioId], references: [id])
  asignadoUsuario        Usuario?               @relation("LeadAsignado", fields: [asignadoUsuarioId], references: [id])
  asignadoPorUsuario     Usuario?               @relation("LeadAsignadoPor", fields: [asignadoPorUsuarioId], references: [id])
  whatsappConversaciones WhatsappConversacion[]
  estadoHistorial        LeadEstadoHistorial[]
  visitas                LeadVisita[]
  calificaciones         LeadCalificacion[]

  leadAutoAsignacionQueue LeadAutoAsignacionQueue[]

  @@unique([organizacionId, idExterno])
  @@index([email])
  @@index([telefono])
  @@index([metaPaginaId])
  @@index([campanaId])
  @@index([anuncioId])
  @@index([fechaLead])
  @@index([estado])
  @@index([asignadoUsuarioId])
  @@index([tipoLead])
  @@index([estadoGestion])
  @@index([organizacionId, estadoGestion])
  @@index([organizacionId, tipoLead, estadoGestion])
  @@map("leads")
}

/**
 * Config + cola para auto-asignación secuencial de leads NUEVO al entrar.
 * (PLAN: round-robin por tenant + orden por lead.fecha_lead)
 */
model LeadAutoAsignacionConfig {
  id String @id @default(uuid()) @db.Uuid

  organizacionId String @unique @map("organizacion_id") @db.Uuid
  habilitado Int @default(0) @map("habilitado") @db.SmallInt

  /**
   * Legacy de 2 usuarios: el orden de estos dos IDs define qué usuario recibe
   * el “primer” lead cuando `usuarioIds` no está configurado (backfill vía migración).
   */
  usuarioPrimeroId String @map("usuario_primero_id") @db.Uuid
  usuarioSegundoId String @map("usuario_segundo_id") @db.Uuid

  /**
   * Lista (N) de IDs para el round-robin (JSONB).
   * Si está vacío/null, la lógica usa [usuarioPrimeroId, usuarioSegundoId]
   * por compatibilidad con configs existentes.
   */
  usuarioIds Json? @map("usuario_ids")

  siguienteIndice Int @default(0) @map("siguiente_indice") @db.SmallInt
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  usuarioPrimero Usuario @relation("LeadAutoAsignacionPrimero", fields: [usuarioPrimeroId], references: [id])
  usuarioSegundo Usuario @relation("LeadAutoAsignacionSegundo", fields: [usuarioSegundoId], references: [id])

  @@map("lead_auto_asignacion_config")
}

/**
 * Cola de leads recién creados para procesar en orden por `fecha_lead`.
 * La fila se elimina cuando se asigna o cuando se descarta porque alguien
 * lo tomó manualmente.
 */
model LeadAutoAsignacionQueue {
  id String @id @default(uuid()) @db.Uuid

  organizacionId String @map("organizacion_id") @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  fechaLead DateTime @map("fecha_lead") @db.Timestamptz
  fechaEncolado DateTime @default(now()) @map("fecha_encolado") @db.Timestamptz

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])

  @@unique([organizacionId, leadId])
  @@index([organizacionId, fechaLead, fechaEncolado])
  @@map("lead_auto_asignacion_queue")
}

/**
 * Timeline inmutable de cambios de estadoGestion/tipoLead — un lead puede
 * tener muchas filas, nunca se editan ni se borran (PLAN-PIPELINE-INMOBILIARIA.md §5.2).
 */
model LeadEstadoHistorial {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid
  leadId         String @map("lead_id") @db.Uuid

  /** Snapshot del tipo de lead al momento del cambio — no sigue al lead si cambia después. */
  tipoLead     String? @map("tipo_lead") @db.VarChar(40)
  /** Null = alta (primera fila del lead). */
  desde        String? @db.VarChar(40)
  hacia        String  @db.VarChar(40)
  motivoCierre String? @map("motivo_cierre") @db.VarChar(80)
  nota         String? @db.VarChar(500)
  /** Contexto ligero (canal, monto ref.) — visitas/calificaciones viven en sus tablas. */
  metadata     Json?
  /** Null = cambio hecho por el sistema (ej. alta automática al ingestar el lead). */
  usuarioId String? @map("usuario_id") @db.Uuid

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  lead              Lead                 @relation(fields: [leadId], references: [id])
  usuario           Usuario?             @relation(fields: [usuarioId], references: [id])
  visitaAgendo      LeadVisita?          @relation("VisitaHistorialAgendo")
  visitaCierra      LeadVisita?          @relation("VisitaHistorialCierra")
  calificacion      LeadCalificacion?    @relation("CalificacionHistorial")

  @@index([leadId, fechaCreacion])
  @@index([organizacionId])
  @@map("lead_estado_historial")
}

/**
 * Cita / visita a inmueble — fuente de verdad para agenda y recordatorios (Fase 22).
 * Se crea al pasar a VISITA_AGENDADA y se cierra al pasar a VISITA_REALIZADA.
 */
model LeadVisita {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid
  leadId         String @map("lead_id") @db.Uuid

  programadaEn       DateTime @map("programada_en") @db.Timestamptz
  referenciaInmueble String   @map("referencia_inmueble") @db.VarChar(300)
  direccion          String?  @db.VarChar(300)
  modalidad          String   @default("PRESENCIAL") @db.VarChar(20)
  puntoEncuentro     String?  @map("punto_encuentro") @db.VarChar(300)

  /** PROGRAMADA | REALIZADA | NO_SHOW | CANCELADA */
  estado    String  @default("PROGRAMADA") @db.VarChar(20)
  /** ASISTIO | NO_SHOW | CANCELADA — al cerrar la visita */
  resultado String? @db.VarChar(20)
  nota      String? @db.VarChar(500)
  feedback  String? @db.VarChar(500)

  historialAgendoId String? @unique @map("historial_agendo_id") @db.Uuid
  historialCierraId String? @unique @map("historial_cierra_id") @db.Uuid

  asignadoUsuarioId  String? @map("asignado_usuario_id") @db.Uuid
  creadoPorUsuarioId String? @map("creado_por_usuario_id") @db.Uuid

  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  lead            Lead                 @relation(fields: [leadId], references: [id])
  historialAgendo LeadEstadoHistorial? @relation("VisitaHistorialAgendo", fields: [historialAgendoId], references: [id])
  historialCierra LeadEstadoHistorial? @relation("VisitaHistorialCierra", fields: [historialCierraId], references: [id])
  asignadoUsuario Usuario?             @relation("LeadVisitaAsignado", fields: [asignadoUsuarioId], references: [id])
  creadoPorUsuario Usuario?            @relation("LeadVisitaCreadoPor", fields: [creadoPorUsuarioId], references: [id])

  @@index([organizacionId, programadaEn])
  @@index([leadId, programadaEn])
  @@index([asignadoUsuarioId, programadaEn])
  @@index([organizacionId, estado, programadaEn])
  @@map("lead_visitas")
}

/**
 * Snapshot de calificación comercial — al pasar a CALIFICADO (Fase 22).
 */
model LeadCalificacion {
  id             String  @id @default(uuid()) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  leadId         String  @map("lead_id") @db.Uuid
  tipoLead       String? @map("tipo_lead") @db.VarChar(40)

  presupuesto      String? @db.VarChar(120)
  zona             String? @db.VarChar(120)
  tipoInmueble     String? @map("tipo_inmueble") @db.VarChar(120)
  tipoPropiedad    String? @map("tipo_propiedad") @db.VarChar(120)
  precioReferencia String? @map("precio_referencia") @db.VarChar(120)
  nota             String  @db.VarChar(500)

  historialId String? @unique @map("historial_id") @db.Uuid
  usuarioId   String? @map("usuario_id") @db.Uuid
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  lead      Lead                 @relation(fields: [leadId], references: [id])
  historial LeadEstadoHistorial? @relation("CalificacionHistorial", fields: [historialId], references: [id])
  usuario   Usuario?             @relation("LeadCalificacionUsuario", fields: [usuarioId], references: [id])

  @@index([leadId, fechaCreacion])
  @@index([organizacionId])
  @@map("lead_calificaciones")
}

model MetaConexion {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id") @db.Uuid

  // Meta App propia de la organización (cada cliente registra la suya) — se
  // guarda antes de iniciar el OAuth; sin esto no se puede generar la URL.
  appId            String? @map("app_id") @db.VarChar(64)
  appSecretCifrado String? @map("app_secret_cifrado")

  // Se completan recién cuando el OAuth de esa app termina con éxito.
  metaUserId       String?   @map("meta_user_id") @db.VarChar(64)
  metaUserNombre   String?   @map("meta_user_nombre") @db.VarChar(200)
  adAccountId      String?   @map("ad_account_id") @db.VarChar(64)
  adAccountNombre  String?   @map("ad_account_nombre") @db.VarChar(200)
  pageId           String?   @map("page_id") @db.VarChar(64)
  pageNombre       String?   @map("page_nombre") @db.VarChar(200)
  tokenCifrado     String?   @map("token_cifrado")
  tokenExpiraEn    DateTime? @map("token_expira_en") @db.Timestamptz
  scopes           String?
  /**
   * IDs de features de meta-permisos-matriz.ts que la org quiere solicitar en
   * OAuth (además de las núcleo, siempre incluidas) — PLAN.md Fase 16.
   */
  featuresDeseadas Json?     @map("features_deseadas")

  webhookVerifyToken String @map("webhook_verify_token") @db.VarChar(128)

  /**
   * Conversions API — dataset de Meta Events Manager dedicado a eventos CRM
   * (distinto del dataset/pixel de sitio web). Lo crea el usuario a mano en
   * Meta Events Manager; acá solo se guarda el id para poder mandar eventos.
   * Null = CAPI Conversion Leads desactivado para esta organización
   * (PLAN-PIPELINE-INMOBILIARIA.md §20.5 / Oleada C).
   */
  capiDatasetId String? @map("capi_dataset_id") @db.VarChar(64)

  estado            Int      @default(1) @db.SmallInt
  usuarioCreacion   String?  @map("usuario_creacion") @db.Uuid
  usuarioEdicion    String?  @map("usuario_edicion") @db.Uuid
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion") @db.Timestamptz

  organizacion         Organizacion             @relation(fields: [organizacionId], references: [id])
  paginas              MetaPagina[]
  cuentasPublicitarias MetaCuentaPublicitaria[]
  whatsappConexiones   WhatsappConexion[]

  // page_id único entre conexiones activas: índice parcial en migración
  // 20260817223000_meta_conexiones_page_id_unique (Prisma DSL no soporta partial unique).
  // pageId/pageNombre/adAccountId/adAccountNombre arriba: deprecados desde Fase 13
  // (PLAN-FASE-13-META-MULTI.md §3.3) — el runtime ya no los escribe, ver meta_paginas
